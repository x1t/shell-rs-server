[Unit]
Description=ShellRS sync server
After=network.target

[Service]
ExecStart=/root/shell-rs-server/shell-rs-server serve -listen 127.0.0.1:18090 -db /root/shell-rs-server/data/sync.db -trust-proxy
WorkingDirectory=/root/shell-rs-server
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/shell-rs-server/data

[Install]
WantedBy=multi-user.target
